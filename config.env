# Settings for the hospital-chain demo. Every value can also be overridden by an environment variable of the same name.
# Read by setup/common.sh (shell) and hcconfig.py (Python). Paths are relative to the repository root unless absolute.

# Amazon S3: the imaging archive (PACS). Create your own bucket and set its name in config.local.env (not here).
HC_S3_BUCKET=your-bucket-name
HC_S3_REGION=ap-south-1
# Optional key prefix inside the bucket (e.g. "hospital-chain/"); empty puts pacs/, thumbs/, index/ at the bucket root
HC_S3_PREFIX=
# AWS CLI profile allowed to upload to the bucket and create the read-only IAM user (setup/s3_reader.sh, data/imaging.py)
HC_AWS_PROFILE=default
# The read-only key Exasol and the console use to read the bucket (written by setup/s3_reader.sh, mode 600)
HC_S3_KEY_FILE=secrets/s3_reader_key.json

# The two branch systems run as podman containers inside the Exasol Personal VM
HC_CONTAINER_PREFIX=hc
HC_PG_PORT=55432
HC_MONGO_PORT=37017

# Exasol: the admin profile in ~/.exapump/config.toml used by the Python set-up scripts
HC_EXAPUMP_PROFILE=starter-kit
# Exasol: the database endpoint the AI agent (exasol-mcp-server) logs in to
# nocertcheck only because Exasol Personal on 127.0.0.1 serves a self-signed certificate. For any remote Exasol use the
# certificate fingerprint instead (host/<sha256>:port), so the connection cannot be intercepted.
HC_EXA_DSN=127.0.0.1/nocertcheck:8563

# The consoles
HC_APP=hospital-chain
HC_DASH_PORT=5100
HC_DASH_PROFILE=starter-kit
HC_STREAMLIT_PORT=8515
